    "concurrently": "^8.2.2",
    "eslint": "^9.33.0",
    "eslint-plugin-vue": "^9.33.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.3",
    "vue-tsc": "^3.3.12"
